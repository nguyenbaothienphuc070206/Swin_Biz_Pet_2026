    "test:visual": "playwright test tests/visual-regression.spec.ts",
    "test:visual:update": "playwright test tests/visual-regression.spec.ts --update-snapshots",
    "load:sos-booking": "node scripts/load-sos-booking.mjs",
    "test:e2e": "playwright test tests/auth-e2e.spec.ts tests/role-authorization.spec.ts tests/data-authorization.spec.ts tests/community-e2e.spec.ts",
    "test:e2e:demo": "playwright test tests/demo-core-flows.spec.ts",
