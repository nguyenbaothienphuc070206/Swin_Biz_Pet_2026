{
  "name": "pawcare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=41",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:ai-evals": "node scripts/run-ai-evals.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=moderate",
    "security:rls": "node scripts/check-rls.mjs",
