NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required by verified billing webhook processing; never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional public origin for sandbox checkout redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional development override for sandbox webhook signing. The sandbox adapter refuses production mode.
BILLING_SANDBOX_WEBHOOK_SECRET=
# Scheduled billing reconciliation endpoint secret; configure in deployment secrets only.
BILLING_JOB_TOKEN=

# Notification delivery worker and email unsubscribe signing; configure only as server secrets.
NOTIFICATION_JOB_TOKEN=
NOTIFICATION_UNSUBSCRIBE_SECRET=
RESEND_API_KEY=
RESEND_FROM=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
AI_EVAL_JOB_TOKEN=
# Optional CI result reporting endpoint and bearer token; never expose the token to the client.
AI_EVAL_REPORT_URL=
# Optional external malware scanner result callback; set only with a configured scanner.
FILE_SCAN_HOOK_TOKEN=

# Optional maps; Google browser key must be restricted by referrer and API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Shared server-only AI gateway. Leave provider empty to use deterministic mock.
PAWCARE_AI_PROVIDER=mock
PAWCARE_AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PAWCARE_AI_DAILY_BUDGET=20
PAWCARE_AI_EVAL_REQUIRED=0

# Optional Playwright accounts provisioned in the Supabase project.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_CLINIC_STAFF_EMAIL=
E2E_CLINIC_STAFF_PASSWORD=
E2E_CLINIC_ADMIN_EMAIL=
E2E_CLINIC_ADMIN_PASSWORD=
E2E_PLATFORM_ADMIN_EMAIL=
E2E_PLATFORM_ADMIN_PASSWORD=
E2E_OTHER_OWNER_EMAIL=
E2E_OTHER_OWNER_PASSWORD=
E2E_OWNER_PET_ID=
E2E_UNGRANTED_PET_ID=
